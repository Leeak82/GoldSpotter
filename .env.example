# Required for live scans. Leave blank to make /api/analyze return a clear 503.
GEMINI_API_KEY=

# Stable flash model. gemini-3.8-flash has been returning 503s, so it is not the default.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated models tried after GEMINI_MODEL on 500, 503, 429, or timeout.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# LOW, MEDIUM, or HIGH. MEDIUM is the default. A result of "unknown" is read once more at HIGH.
GEMINI_MEDIA_RESOLUTION=MEDIUM

# Optional. Used when Gemini is unset or fails.
GROQ_API_KEY=

# Vision-capable Groq model. Ignored unless GROQ_API_KEY is set.
GROQ_MODEL=qwen/qwen3.8-27b

# Local port. Render sets PORT for you.
PORT=8787
